# ==========================================
# PRIMECARE X-RAY SERVICE (Python 3.8 / FastAPI)
# Copy file này thành .env. KHÔNG commit .env
# ==========================================

XRAY_SERVICE_PORT=9005

# --- JWT: phải GIỐNG HỆT jwt.secret-key của user-service (HS512, >= 64 byte) ---
JWT_SECRET_KEY=5c4b406804cf14ef2fea719598e07d7d7c6c15d26eea55040597cb2ab6a6d35b

# --- Mô hình ---
# Nạp sẵn cả hai lúc khởi động, bác sĩ chọn khi phân tích
MODELS=["v4_lite","v3_fast"]
DEFAULT_MODEL=v4_lite
# Để trống = tự dùng GPU nếu có (cuda:0), không có thì CPU. Ép CPU: DEVICE=cpu
DEVICE=
DETECTOR_DIR=oralxrays9_detector
DEFAULT_SCORE_THR=0.3
MAX_UPLOAD_MB=10

# --- Eureka (để gateway route lb://xray-service) ---
EUREKA_ENABLED=true
EUREKA_URL=http://localhost:8761/eureka/
# Địa chỉ gateway dùng để gọi service. host.docker.internal = giống các service Java. Để trống = 127.0.0.1
EUREKA_INSTANCE_HOST=host.docker.internal
